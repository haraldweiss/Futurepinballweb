{
  "name": "futurepinball-web",
  "version": "0.24.1",
  "description": "Browser pinball simulator with 3D rendering, experimental Future Pinball import and cabinet support",
  "author": {
    "name": "Future Pinball Contributors",
    "email": "noreply@futurepinball.invalid"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "electron-main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "vite src",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server.js",
    "start": "node start-game.js",
    "start:1": "node start-game.js 1",
    "start:2": "node start-game.js 2",
    "start:3": "node start-game.js 3",
    "start:auto": "node start-game.js auto",
    "stop": "node stop-game.js",
    "stop:force": "node stop-game.js --force",
    "install:setup": "node scripts/installer.js",
    "install:check": "node scripts/installer.js --check-only",
    "electron-dev": "electron . --inspect",
    "electron-build": "npm run build && electron-builder",
    "electron-dist": "npm run build && electron-builder --publish never",
    "electron-win": "npm run build && electron-builder --win",
    "electron-mac": "npm run build && electron-builder --mac",
    "electron-linux": "npm run build && electron-builder --linux",
    "test:security": "tsx src/test-security.ts",
    "test:suite": "tsx src/test-suite.ts",
    "test:integration": "tsx src/integration-testing.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:security": "eslint src --config eslint.security.config.mjs",
    "audit:dependencies": "npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high",
    "security:check": "npm run lint:security && npm run test:security && npm run audit:dependencies",
    "typecheck": "tsc --noEmit",
    "test:lint-security": "node --test scripts/security-lint.test.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "fflate": ">=0.8.3",
    "postcss": "^8.5.18",
    "global-agent": "^4.1.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.1",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/ui": "^4.1.11",
    "cfb": "1.2.2",
    "electron": "43.8.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.4",
    "rollup": "^4.62.3",
    "tar": "^7.5.22",
    "tsx": "^4.6.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.futurepinball.web",
    "productName": "Future Pinball Web",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "electron-preload.cjs",
      "public/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "haraldweiss",
      "repo": "Futurepinballweb",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": null,
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Future Pinball Web"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
